{
  "name": "kartlink-p2p",
  "version": "1.0.1",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win portable",
    "test": "node --test tests/playit.test.cjs",
    "test:ui": "npm run build && node --test tests/ui.test.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "panelui-web": "^0.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "bun": "^1.4.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "org.kartlink.p2p",
    "productName": "KartLink P2P",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "license": "GPL-3.0-or-later"
}
