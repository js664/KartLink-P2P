{
  "name": "kartlink-p2p",
  "version": "1.0.2",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "package": "node scripts/release.cjs",
    "test": "node --test tests/playit.test.cjs tests/diagnostics.test.cjs tests/portable.test.cjs",
    "test:ui": "npm run build && node --test tests/ui.test.cjs",
    "package:installer": "node scripts/release.cjs installer",
    "package:portable": "node scripts/release.cjs portable"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "bun": "^1.4.4",
    "clsx": "^2.1.1",
    "electron": "45.2.2",
    "electron-builder": "^26.0.12",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "panelui-web": "^0.12.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "org.kartlink.p2p",
    "productName": "KartLink P2P",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "eden-room.exe",
          "playitd.exe",
          "LICENSE-*.txt"
        ]
      },
      {
        "from": "assets/kartlink.ico",
        "to": "resources/kartlink.ico"
      }
    ],
    "win": {
      "icon": "assets/kartlink.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "KartLink-P2P-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KartLink P2P",
      "uninstallDisplayName": "KartLink P2P",
      "runAfterFinish": false
    }
  },
  "license": "GPL-3.0-or-later",
  "description": "Host Eglantine rooms using Playit.",
  "author": "KartLink contributors"
}
